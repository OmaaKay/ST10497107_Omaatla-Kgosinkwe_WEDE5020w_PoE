@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="container">
    <div class="rd-auth-wrap" style="max-width:680px">
        <div class="rd-auth-card">
            <h1 class="mb-1">Join RaceDay</h1>
            <p class="text-muted">Create your account in under a minute.</p>

            <form asp-action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" autocomplete="email" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <div class="form-text">At least 8 characters.</div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" type="tel" class="form-control" autocomplete="tel" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label for="DateOfBirth" class="form-label">Date of birth</label>
                        <input id="DateOfBirth" name="DateOfBirth" type="date" class="form-control" value="@(Model.DateOfBirth?.ToString("yyyy-MM-dd"))" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label d-block">I am a</label>
                        <div class="row g-3">
                            <div class="col-sm-6">
                                <input type="radio" class="btn-check" name="Role" id="roleParticipant" value="Participant" checked="@(Model.Role != "Organiser")" />
                                <label class="rd-category" for="roleParticipant"><i class="bi bi-person-walking fs-4 text-primary"></i> <strong>Participant</strong><br /><small class="text-muted">Browse events, enrol and track results</small></label>
                            </div>
                            <div class="col-sm-6">
                                <input type="radio" class="btn-check" name="Role" id="roleOrganiser" value="Organiser" checked="@(Model.Role == "Organiser")" />
                                <label class="rd-category" for="roleOrganiser"><i class="bi bi-clipboard2-data fs-4 text-primary"></i> <strong>Organiser</strong><br /><small class="text-muted">Create events and manage results</small></label>
                            </div>
                        </div>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary w-100 btn-lg mt-4" data-busy="Creating account…">Create account</button>
            </form>
            <p class="text-center mt-4 mb-0">Already registered? <a asp-action="Login">Log in</a></p>
        </div>
    </div>
</div>
