@{
    ViewData["Title"] = "Run it. Ride it. Own it.";
}
<section class="rd-hero">
    <div class="container position-relative" style="z-index:1">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="rd-role-pill mb-3 d-inline-block">Race management made simple</span>
                <h1>Find your next <span>start line.</span></h1>
                <p class="lead mt-3">RaceDay connects runners, walkers and cyclists with the events they love. Browse upcoming races, enrol in seconds and track every finish time in one place.</p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register"><i class="bi bi-lightning-charge-fill"></i> Join RaceDay</a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Log in</a>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="row g-3">
                    <div class="col-6"><div class="rd-hero-stat"><b>3</b>Event types: run, walk, cycle</div></div>
                    <div class="col-6"><div class="rd-hero-stat"><b>2</b>Roles: Participant &amp; Organiser</div></div>
                    <div class="col-12"><div class="rd-hero-stat"><b>47<sup>th</sup> / 312</b>Your finishing position, always on record</div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container" style="margin-top:-2.2rem; position:relative; z-index:2">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="rd-feature">
                <div class="rd-icon"><i class="bi bi-compass"></i></div>
                <h3>Discover events</h3>
                <p class="mb-0 text-muted">Filter upcoming events by type, date and location, then see every category on offer.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rd-feature">
                <div class="rd-icon"><i class="bi bi-ticket-perforated"></i></div>
                <h3>Enrol instantly</h3>
                <p class="mb-0 text-muted">Pick your category and you're in. Follow your enrolment status from pending to confirmed.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="rd-feature">
                <div class="rd-icon"><i class="bi bi-trophy"></i></div>
                <h3>Track your results</h3>
                <p class="mb-0 text-muted">Finish times and positions are published by organisers and saved in your race history.</p>
            </div>
        </div>
    </div>

    <div class="rd-panel mt-5 d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="mb-1">Organising a race?</h2>
            <p class="mb-0 text-muted">Create events, upload banners, set up categories, confirm enrolments and publish results from one dashboard.</p>
        </div>
        <a class="btn btn-dark" asp-controller="Account" asp-action="Register">Register as an Organiser <i class="bi bi-arrow-right"></i></a>
    </div>
</section>
