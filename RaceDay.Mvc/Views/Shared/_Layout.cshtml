@{
    var session = Context.Session;
    var signedIn = session.IsSignedIn();
    var role = session.GetRole();
    var fullName = session.GetFullName();
    var picture = session.GetPicture();
    var controller = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    string Active(params string[] names) => names.Contains(controller, StringComparer.OrdinalIgnoreCase) ? "active" : string.Empty;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "RaceDay") · RaceDay</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><rect width='64' height='64' rx='14' fill='%23FF5A1F'/><path d='M14 46 28 14h8L22 46zm16 0 14-32h8L38 46z' fill='white'/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark rd-navbar">
        <div class="container">
            <a class="navbar-brand rd-brand" asp-controller="Home" asp-action="Index">
                <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#FF5A1F"/><path d="M14 46 28 14h8L22 46zm16 0 14-32h8L38 46z" fill="#fff"/></svg>
                <span>RACE<b>DAY</b></span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (!signedIn)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door"></i> Home</a></li>
                    }
                    else if (role == Roles.Organiser)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Organiser")" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @Active("OrganiserEvents", "Events")" asp-controller="OrganiserEvents" asp-action="Index"><i class="bi bi-calendar-event"></i> Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("OrganiserCategories")" asp-controller="OrganiserCategories" asp-action="Index"><i class="bi bi-tags"></i> Categories</a></li>
                        <li class="nav-item"><a class="nav-link @Active("OrganiserEnrolments")" asp-controller="OrganiserEnrolments" asp-action="Index"><i class="bi bi-people"></i> Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @Active("OrganiserResults")" asp-controller="OrganiserResults" asp-action="Index"><i class="bi bi-stopwatch"></i> Results</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @Active("Home", "Events")" asp-controller="Home" asp-action="Index"><i class="bi bi-compass"></i> Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("MyEvents")" asp-controller="MyEvents" asp-action="Index"><i class="bi bi-ticket-perforated"></i> My Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("MyResults")" asp-controller="MyResults" asp-action="Index"><i class="bi bi-trophy"></i> My Results</a></li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center gap-lg-2">
                    @if (signedIn)
                    {
                        <li class="nav-item">
                            <a class="nav-link d-flex align-items-center gap-2 @Active("Profile")" asp-controller="Profile" asp-action="Index">
                                @if (!string.IsNullOrEmpty(picture))
                                {
                                    <img class="rd-avatar" src="@picture" alt="" />
                                }
                                else
                                {
                                    <span class="rd-avatar rd-avatar-initials">@Display.Initials(fullName)</span>
                                }
                                <span>@fullName</span>
                                <span class="rd-role-pill">@role</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm"><i class="bi bi-box-arrow-right"></i> Log out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @Active("Account")" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="rd-main">
    <div class="container">
        @foreach (var (key, css, icon) in new[] { ("Success", "success", "bi-check-circle-fill"), ("Error", "danger", "bi-exclamation-octagon-fill"), ("Warning", "warning", "bi-exclamation-triangle-fill"), ("Info", "info", "bi-info-circle-fill") })
        {
            if (TempData[key] is string message && !string.IsNullOrWhiteSpace(message))
            {
                <div class="alert alert-@css rd-alert d-flex align-items-start gap-2 mt-3" role="alert">
                    <i class="bi @icon"></i>
                    <div>@message</div>
                </div>
            }
        }
    </div>
    @RenderBody()
</main>

<footer class="rd-footer">
    <div class="container d-flex flex-wrap justify-content-between gap-2">
        <span><strong>RACEDAY</strong> · Run it. Ride it. Own it.</span>
        <span>&copy; @DateTime.Now.Year RaceDay · PROG6212 POE Part 3</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
